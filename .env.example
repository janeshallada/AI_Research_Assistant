# ==== LLM Provider ====
# Leave OPENAI_API_KEY empty to run the assistant in local "MOCK" mode
# (extractive answers, no external API calls) — useful for offline demos/tests.
OPENAI_API_KEY=your_key_here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=mock          # options: openai | mock

# ==== Embeddings ====
EMBEDDING_PROVIDER=local   # options: local (sentence-transformers) | openai
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==== Storage Paths ====
RAW_DOCUMENTS_DIR=./data/raw_documents
VECTOR_DB_DIR=./data/vector_db
SQLITE_DB_PATH=./data/app.db
MODEL_PATH=./models/tf_classifier.keras
TOKENIZER_PATH=./models/tokenizer.pickle
LABELS_PATH=./models/labels.json

# ==== Chunking ====
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ==== Retrieval ====
RETRIEVAL_TOP_K=4

# ==== App ====
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
