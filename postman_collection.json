{
  "info": {
    "name": "AI Research & Knowledge Assistant",
    "description": "REST API collection for the AI Research & Knowledge Assistant backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "doc_id", "value": "" },
    { "key": "doc_id_2", "value": "" },
    { "key": "session_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": { "method": "GET", "url": "{{base_url}}/health" }
    },
    {
      "name": "Upload Document",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/documents/upload",
        "body": {
          "mode": "formdata",
          "formdata": [ { "key": "file", "type": "file", "src": "" } ]
        }
      }
    },
    {
      "name": "List Documents",
      "request": { "method": "GET", "url": "{{base_url}}/documents" }
    },
    {
      "name": "Get Document",
      "request": { "method": "GET", "url": "{{base_url}}/documents/{{doc_id}}" }
    },
    {
      "name": "Reprocess Document",
      "request": { "method": "POST", "url": "{{base_url}}/documents/{{doc_id}}/reprocess" }
    },
    {
      "name": "Delete Document",
      "request": { "method": "DELETE", "url": "{{base_url}}/documents/{{doc_id}}" }
    },
    {
      "name": "Search (Hybrid)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/search",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"what chunking strategy is used\",\n  \"top_k\": 4,\n  \"mode\": \"hybrid\"\n}"
        }
      }
    },
    {
      "name": "Ask Question (RAG QA)",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/qa",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What is this document about?\",\n  \"session_id\": \"{{session_id}}\",\n  \"mode\": \"hybrid\"\n}"
        }
      }
    },
    {
      "name": "Summarize Document",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/analysis/summarize",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"doc_id\": \"{{doc_id}}\"\n}" }
      }
    },
    {
      "name": "Compare Documents",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/analysis/compare",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"doc_ids\": [\"{{doc_id}}\", \"{{doc_id_2}}\"]\n}" }
      }
    },
    {
      "name": "Classify Document",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/analysis/classify",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"doc_id\": \"{{doc_id}}\"\n}" }
      }
    },
    {
      "name": "Analytics Summary",
      "request": { "method": "GET", "url": "{{base_url}}/analytics/summary" }
    },
    {
      "name": "Top Queried Documents",
      "request": { "method": "GET", "url": "{{base_url}}/analytics/top-documents" }
    }
  ]
}
